#EXTINF:-1 tvg-id="tmdb_movie_15152" tvg-name="OSS 117: El Cairo, nido de espías" tvg-logo="https://image.tmdb.org/t/p/w500/qwFDCKVOlgTAzeaLUmCwtbRLfsL.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/mrRzR4Xbt64heUQF5YBMMfdMEXu.jpg" tvg-type="movie" tvg-genre="High-Octane Action" tvg-description="Egipto, 1955. El Cairo es un verdadero nido de espías. Nadie confía en nadie, todos conspiran contra todos: ingleses, franceses, soviéticos, la familia del rey Farouk que quiere recuperar el trono, las Águilas de Keops, secta religiosa que quiere tomar el poder... Para acabar con esta situación caótica, René Coty, el Presidente de la República francesa, envía al mejor agente francés: Hubert Bonisseur de la Bath, conocido como OSS 117 (Jean Dujardin)." tvg-year="2006" tvg-cast="Jean Dujardin, Bérénice Bejo, Aure Atika, Philippe Lefebvre, Constantin Alexandrov" tvg-director="Michel Hazanavicius" group-title="High-Octane Action",OSS 117: El Cairo, nido de espías
