#EXTINF:-1 tvg-id="tmdb_movie_18654" tvg-name="Cafeína" tvg-logo="https://image.tmdb.org/t/p/w500/9XOO0EkctFIxgUuy7YlJCV4kbnV.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/ovPpGP2173A2Ltksvk56W59pU4p.jpg" tvg-type="movie" tvg-genre="Midnight Cult Cinema" tvg-description="Una fantástica batalla de sexos se produce cuando las relaciones entre el personal y los clientes de un peculiar café de Londres se ven inesperadamente patas arriba por revelaciones repentinas de secretos terriblemente vergonzosos que tienen que ver con sus desventuras sexuales. La comida no es tan buena, pero podéis ser vosotros mismos y mostraros como sois: maníacos, pervertidos, gays, tramposos, viejas violentas, travestis, cantantes quejosos, corazones rotos... Pasad, que hay sitio. !" tvg-year="2006" tvg-cast="Marsha Thomason, Breckin Meyer, Mena Suvari, Katherine Heigl, Callum Blue" tvg-director="John Cosgrove" group-title="Midnight Cult Cinema",Cafeína
