#EXTINF:-1 tvg-id="tmdb_tv_2603_slot_02_s01e01" tvg-series-id="tmdb_tv_2603_slot_02" tvg-name="Hex S01E01 - The Story Begins (1)" tvg-logo="https://image.tmdb.org/t/p/w500/rYaZSE48K6usylHfC6QKsFChXmx.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/bihkhvuMZ510JnsUIgmzUTSqiLF.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/24OnInrQ6kjMVV3GDSrBFVW24JD.jpg" tvg-type="series" tvg-genre="Умопомрачительные триллеры" tvg-description="Кэсси — отличница, которая поступает в шикарную школу-интернат под названием Меденхем-Холл, построенную на фоне работорговли. В начале семестра она подвергается обычному унизительному опыту со стороны своих сверстников, но это меньше всего ее беспокоит. Терзаемая образами насилия и преследуемая загадочным мужчиной, она понимает, что у нее появились способности, которые изменят ее жизнь." tvg-year="2004" tvg-cast="Jemima Rooper, Jamie Davis, Laura Pyper, Jemima Abey" tvg-series-title="Hex" tvg-episode-title="The Story Begins (1)" tvg-season="1" tvg-episode="1" group-title="Шестигранник",Hex S01E01 - The Story Begins (1)
