#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e02" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="Час комедии Colgate S01E02 - Давайте посмотрим правде в глаза" tvg-logo="https://picsum.photos/seed/1773-the-colgate-comedy-hour-s01e02-let-s-face-it-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1773-the-colgate-comedy-hour-s01e02-let-s-face-it-backdrop/1600/900" tvg-type="series" tvg-genre="Классический саспенс-телевидение" tvg-description="Ведущие Дин Мартин и Джерри Льюис, Дин и Джерри вместе с великолепной Мэрилин Максвелл («Малыш с лимонной каплей») и комиком Леонардом Барром. Зарисовки включают в себя закулисный фрагмент, где Мартин и Льюис бездельничают в своей гримерке, и еще один, где Джерри играет маленького ребенка, который ходит в кино со взрослым Дином." tvg-year="1950" tvg-series-title="Час комедии Колгейта" tvg-episode-title="Давайте посмотрим правде в глаза" tvg-season="1" tvg-episode="2" group-title="Час комедии Колгейта",Час комедии Colgate S01E02 - Давайте посмотрим правде в глаза
