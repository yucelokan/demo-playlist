#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_32_s01e01" tvg-series-id="tmdb_tv_2955_slot_32" tvg-name="Пуш, Невада S01E01 – Сумма" tvg-logo="https://picsum.photos/seed/1298-push-nevada-s01e01-the-amount-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1298-push-nevada-s01e01-the-amount-backdrop/1600/900" tvg-type="series" tvg-genre="Ретро научно-фантастические сериалы" tvg-description="Когда из хранилища казино в отдаленном пустынном городке Пуш, штат Невада, украдена крупная сумма денег, агент IRS Джим Пруфрок узнает, что кража могла быть растратой, и отправляется на расследование.  Однако он не чувствует себя желанным гостем, поскольку ему говорят либо убираться из города, либо «принимать осторожные меры», а встреча с менеджером казино заканчивается угрозами." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Пуш, Невада" tvg-episode-title="Количество" tvg-season="1" tvg-episode="1" group-title="Пуш, Невада",Push,Невада S01E01 - Сумма
