#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e01" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="Час комедии Colgate S01E01 - Месть под музыку" tvg-logo="https://picsum.photos/seed/1772-the-colgate-comedy-hour-s01e01-revenge-with-music-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1772-the-colgate-comedy-hour-s01e01-revenge-with-music-backdrop/1600/900" tvg-type="series" tvg-genre="Классический саспенс-телевидение" tvg-description="Эдди Кантор ведет премьерный эпизод сериала, к которому присоединяются актер/танцор Томми Уандер, оперное сопрано Има Сумак, танцор Дэнни Дэниэлс, звезда идишского театра Джозеф Булофф, Лью Хирн, Роберт Гари, Джек Альбертсон, балетная команда Вэла Баттингнола и Джой Уильямс, а также Эл Гудман и его оркестр. Программа рекламировалась в газете «Нью-Йорк Таймс» как «ностальгический обзор, напоминающий о безмятежных днях театра Нью-Амстердам на Бродвее и 42-й улице»." tvg-year="1950" tvg-series-title="Час комедии Колгейта" tvg-episode-title="Месть с музыкой" tvg-season="1" tvg-episode="1" group-title="Час комедии Колгейта",Час комедии Colgate S01E01 - Месть под музыку
