#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_23_s01e01" tvg-series-id="tmdb_tv_2955_slot_23" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Высокооктановое действие" tvg-description="Когда из хранилища казино в отдаленном пустынном городке Пуш, штат Невада, украдена крупная сумма денег, агент IRS Джим Пруфрок узнает, что кража могла быть растратой, и отправляется на расследование.  Однако он не чувствует себя желанным гостем, поскольку ему говорят либо убираться из города, либо «принимать осторожные меры», а встреча с менеджером казино заканчивается угрозами." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="Пуш, Невада",Push,Nevada S01E01 - The Amount
