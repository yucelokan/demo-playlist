#EXTINF:-1 tvg-id="tmdb_tv_2603_slot_47_s01e01" tvg-series-id="tmdb_tv_2603_slot_47" tvg-name="Hex S01E01 - История начинается (1)" tvg-logo="https://picsum.photos/seed/1830-hex-s01e01-the-story-begins-1-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1830-hex-s01e01-the-story-begins-1-backdrop/1600/900" tvg-episode-still="https://image.tmdb.org/t/p/w500/24OnInrQ6kjMVV3GDSrBFVW24JD.jpg" tvg-type="series" tvg-genre="Классический саспенс-телевидение" tvg-description="Кэсси — отличница, которая поступает в шикарную школу-интернат под названием Меденхем-Холл, построенную на фоне работорговли. В начале семестра она подвергается обычному унизительному опыту со стороны своих сверстников, но это меньше всего ее беспокоит. Терзаемая образами насилия и преследуемая загадочным мужчиной, она понимает, что у нее появились способности, которые изменят ее жизнь." tvg-year="2004" tvg-cast="Jemima Rooper, Jamie Davis, Laura Pyper, Jemima Abey" tvg-series-title="Шестигранник" tvg-episode-title="История начинается (1)" tvg-season="1" tvg-episode="1" group-title="Шестигранник",Hex S01E01 - История начинается (1)
