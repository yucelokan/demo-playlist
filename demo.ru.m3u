#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_34_s01e08" tvg-series-id="tmdb_tv_4515_slot_34" tvg-name="Lois & Clark: The New Adventures of Superman S01E08 - The Green, Green Glow of Home" tvg-logo="https://image.tmdb.org/t/p/w500/1LbPs6i1h4BKjVUwK5S9GjPCydi.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/etYhbQsE8jLvNNVQdKLeHnGRx1B.jpg" tvg-type="series" tvg-genre="Ретро научно-фантастические сериалы" tvg-description="Друг Джонатана и Марты нашел странный метеорит. Джейсон Траск вернулся и теперь находится в Смоллвилле в поисках метеорита, способного уничтожить Супермена. Лоис и Кларк отправляются в Смоллвиль, чтобы расследовать эту историю, и Кларк знакомит ее со своими родителями." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Lois & Clark: The New Adventures of Superman" tvg-episode-title="The Green, Green Glow of Home" tvg-season="1" tvg-episode="8" group-title="Лоис и Кларк: Новые приключения Супермена",Lois & Clark: The New Adventures of Superman S01E08 - The Green,Green Glow of Home
