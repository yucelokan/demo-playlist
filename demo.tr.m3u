#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_05_s01e02" tvg-series-id="tmdb_tv_2955_slot_05" tvg-name="Push, Nevada S01E02 - Kara Kutu" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Akıl almaz gerilim filmleri" tvg-description="Push'taki cinayet, Jim'i katilin kimliğine dair ipuçları aramaya sevk eder, ancak çabaları, ölümün bir intihar olduğu konusunda ısrar eden kasaba şerifi ve onun aptal yardımcısı tarafından engellenir, ancak münzevi bir dövme sanatçısı suçu kimin işlediğine dair bir ipucu tutabilir. Bu arada, Nevada Kumar Komisyonu'ndan olduklarını iddia eden iyi giyimli adamlardan oluşan bir ekip, ölümün sonuçlarıyla ilgilenmek için gelir ve Mary, çalınan ganimeti geri almak için harekete geçer." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="İt, Nevada" tvg-episode-title="Kara Kutu" tvg-season="1" tvg-episode="2" group-title="İt, Nevada",Push,Nevada S01E02 - Kara Kutu
