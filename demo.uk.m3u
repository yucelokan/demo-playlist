#EXTINF:-1 tvg-id="live_documentaries_02" tvg-name="Docu HD 2" tvg-logo="https://image.tmdb.org/t/p/w500/dDVHVZVEbTV4JsB8ZjdXNmMK7rA.jpg" tvg-type="live" tvg-genre="Документальні фільми" tvg-description="Дія відбувається в 1955 році: французький секретний агент Юбер Боніссер де Ла Бат/OSS 117 відправляється в Каїр для розслідування зникнення свого найкращого друга та товариша-розвідника Джека Джефферсона, але натрапляє на мережу міжнародних інтриг." group-title="Документальні фільми" tvg-backdrop="https://image.tmdb.org/t/p/w1280/mrRzR4Xbt64heUQF5YBMMfdMEXu.jpg",Docu HD 2
