#EXTINF:-1 tvg-id="tmdb_movie_22825" tvg-name="The Box" tvg-logo="https://image.tmdb.org/t/p/w500/xMAmOu6xl4CsstixcuecBle9krd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/kjVhc1Ba9dFhgsdzQLGKrUbfe1q.jpg" tvg-type="movie" tvg-genre="Високооктанова дія" tvg-description="Норма та Артур Льюїс, подружжя з передмістя з маленькою дитиною, отримують у подарунок просту дерев’яну скриньку, яка тягне за собою фатальні та безповоротні наслідки. Таємничий незнайомець доставляє повідомлення про те, що скринька обіцяє подарувати своєму власникові 1 мільйон доларів одним натисканням кнопки. Однак натискання цієї кнопки одночасно призведе до смерті іншої людини десь у світі; хтось, кого вони не знають. Маючи лише 24 години, щоб отримати коробку, Норма та Артур опиняються перед приголомшливою моральною дилемою та повинні зіткнутися зі справжньою природою своєї людяності." tvg-year="2009" tvg-cast="Cameron Diaz, James Marsden, Frank Langella, James Rebhorn, Holmes Osborne" tvg-director="Richard Kelly" group-title="Високооктанова дія",The Box
