#EXTINF:-1 tvg-id="tmdb_tv_2603_slot_29_s01e05" tvg-series-id="tmdb_tv_2603_slot_29" tvg-name="Hex S01E05 - Possession" tvg-logo="https://image.tmdb.org/t/p/w500/rYaZSE48K6usylHfC6QKsFChXmx.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/bihkhvuMZ510JnsUIgmzUTSqiLF.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/4hbKCosMc0V4YHaKVVWzYUr9sYU.jpg" tvg-type="series" tvg-genre="Високооктанова дія" tvg-description="Без сумніву, Кессі змінилася. Вона носить сексуальний облягаючий одяг; вона вороже ставиться до Тельми і випромінює ставлення. Вона майже не звертає уваги на юного Троя, але це лише робить його ще більш відчайдушним бажанням бути з нею. Його друзі не можуть зрозуміти, чому він дозволяє так поводитися з собою, але він не може протистояти їй." tvg-year="2004" tvg-cast="Jemima Rooper, Jamie Davis, Laura Pyper, Jemima Abey" tvg-series-title="Hex" tvg-episode-title="Possession" tvg-season="1" tvg-episode="5" group-title="Hex",Hex S01E05 - Possession
