#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_05_s01e01" tvg-series-id="tmdb_tv_2955_slot_05" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Запаморочливі трилери" tvg-description="Коли зі сховища казино у віддаленому пустельному містечку Пуш, штат Невада, викрадають велику суму грошей, агент податкової служби Джим Пруфрок отримує підказку, що ця крадіжка може бути розтратою, тому він вирушає розслідувати.  Однак він не відчуває себе бажаним, оскільки йому наказано виїхати з міста або «вжити обережних заходів», а зустріч з менеджером казино закінчується погрозами." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="Натискай, Невада",Push,Nevada S01E01 - The Amount
