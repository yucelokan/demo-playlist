#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_23_s01e02" tvg-series-id="tmdb_tv_2955_slot_23" tvg-name="Push, Nevada S01E02 - The Black Box" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Високооктанова дія" tvg-description="Вбивство в Push змушує Джима шукати підказки щодо особи вбивці, але його зусиллям заважають міський шериф і його тупий заступник, які наполягають на тому, що смерть була самогубством, хоча татуювальник-самітник може мати підказку до того, хто вчинив злочин. Тим часом прибуває команда добре одягнених чоловіків, які стверджують, що належать до Комісії з ігор штату Невада, щоб розібратися з наслідками смерті, а Мері йде, щоб повернути вкрадену здобич." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Black Box" tvg-season="1" tvg-episode="2" group-title="Натискай, Невада",Push,Nevada S01E02 - The Black Box
