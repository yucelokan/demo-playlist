#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_43_s01e08" tvg-series-id="tmdb_tv_4515_slot_43" tvg-name="Lois & Clark: The New Adventures of Superman S01E08 - The Green, Green Glow of Home" tvg-logo="https://image.tmdb.org/t/p/w500/1LbPs6i1h4BKjVUwK5S9GjPCydi.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/etYhbQsE8jLvNNVQdKLeHnGRx1B.jpg" tvg-type="series" tvg-genre="TV Ketegangan Klasik" tvg-description="Teman Jonathan dan Martha menemukan meteorit yang aneh. Jason Trask telah kembali dan sekarang dia berada di Smallville, mencari meteorit yang dapat menghancurkan Superman. Lois dan Clark pergi ke Smallville untuk menyelidiki ceritanya dan Clark memperkenalkannya kepada orang tuanya." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Lois & Clark: The New Adventures of Superman" tvg-episode-title="The Green, Green Glow of Home" tvg-season="1" tvg-episode="8" group-title="Lois & Clark: Petualangan Baru Superman",Lois & Clark: The New Adventures of Superman S01E08 - The Green,Green Glow of Home
