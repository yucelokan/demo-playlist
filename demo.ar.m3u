#EXTINF:-1 tvg-id="tmdb_movie_10398" tvg-name="Double Jeopardy" tvg-logo="https://image.tmdb.org/t/p/w500/dPd9QvEeMQpgHO6iLB1LqALTZl.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/fk4NXhazfRKtQaVEV9IPeM7OIVH.jpg" tvg-type="movie" tvg-genre="عمل عالي الأوكتان" tvg-description="ليبي بارسونز، التي أدينت خطأً بقتل زوجها نيك، تعتقد أنه لا يزال على قيد الحياة. لقد نجت من السنوات الطويلة في السجن مع رغبتين ملتهبتين تدعمها - العثور على ابنها وحل اللغز الذي دمر حياتها التي كانت سعيدة في السابق. لكن يقف بينها وبين سعيها ضابط الإفراج المشروط ترافيس ليمان. تشكل ليبي تحديًا للضابط الساخر، وهو التحدي الذي يجبره على مواجهة إخفاقاته بينما يضعه في مواجهة رئيسه وزملائه في إنفاذ القانون، بينما تنغمس في معركة يائسة من أجل العدالة والبقاء والانتقام." tvg-year="1999" tvg-cast="Ashley Judd, Tommy Lee Jones, Bruce Greenwood, Annabeth Gish, Benjamin Weir" tvg-director="Bruce Beresford" group-title="عمل عالي الأوكتان",Double Jeopardy
