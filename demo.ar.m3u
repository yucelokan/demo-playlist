#EXTINF:-1 tvg-id="tmdb_movie_22825" tvg-name="The Box" tvg-logo="https://image.tmdb.org/t/p/w500/xMAmOu6xl4CsstixcuecBle9krd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/kjVhc1Ba9dFhgsdzQLGKrUbfe1q.jpg" tvg-type="movie" tvg-genre="عمل عالي الأوكتان" tvg-description="نورما وآرثر لويس، زوجان من الضواحي ولديهما طفل صغير، يحصلان على صندوق خشبي بسيط كهدية، الأمر الذي يؤدي إلى عواقب وخيمة وغير قابلة للإلغاء. يقوم شخص غريب غامض بتوصيل رسالة مفادها أن الصندوق يعد بمنح مالكه مليون دولار بضغطة زر. لكن الضغط على هذا الزر سيؤدي في نفس الوقت إلى وفاة إنسان آخر في مكان ما من العالم؛ شخص لا يعرفونه. مع وجود الصندوق في حوزتهم لمدة 24 ساعة فقط، تجد نورما وآرثر نفسيهما في مرمى معضلة أخلاقية مذهلة ويجب عليهما مواجهة الطبيعة الحقيقية لإنسانيتهما." tvg-year="2009" tvg-cast="Cameron Diaz, James Marsden, Frank Langella, James Rebhorn, Holmes Osborne" tvg-director="Richard Kelly" group-title="عمل عالي الأوكتان",The Box
