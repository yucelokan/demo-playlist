#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e02" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="ساعة كولجيت للكوميديا S01E02 - فلنواجه الأمر" tvg-logo="https://picsum.photos/seed/1773-the-colgate-comedy-hour-s01e02-let-s-face-it-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1773-the-colgate-comedy-hour-s01e02-let-s-face-it-backdrop/1600/900" tvg-type="series" tvg-genre="تلفزيون التشويق الكلاسيكي" tvg-description="يستضيفه دين مارتن وجيري لويس، ويضم دين وجيري جنبًا إلى جنب مع مارلين ماكسويل الرائعة ('The Lemon Drop Kid') والممثل الكوميدي ليونارد بار. تتضمن الرسومات التخطيطية جزءًا من وراء الكواليس حيث يتجول مارتن ولويس في غرفة تبديل الملابس الخاصة بهما، وأخرى يظهر فيها جيري وهو يلعب دور طفل صغير يذهب إلى السينما مع دين البالغ." tvg-year="1950" tvg-series-title="ساعة كولجيت للكوميديا" tvg-episode-title="دعونا نواجه الأمر" tvg-season="1" tvg-episode="2" group-title="ساعة كولجيت للكوميديا",ساعة كولجيت للكوميديا S01E02 - فلنواجه الأمر
