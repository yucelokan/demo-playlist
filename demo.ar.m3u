#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_23_s01e01" tvg-series-id="tmdb_tv_2955_slot_23" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="عمل عالي الأوكتان" tvg-description="عندما يُسرق مبلغ كبير من المال من قبو كازينو في بلدة بوش الصحراوية النائية بولاية نيفادا، يحصل عميل مصلحة الضرائب جيم بروفروك على معلومات تفيد بأن السرقة قد تكون اختلاسًا، لذلك يذهب للتحقيق.  ومع ذلك، لم يشعر بالترحيب، حيث يُطلب منه إما الخروج من المدينة أو "اتخاذ خطوات حذرة"، وينتهي الاجتماع مع مدير الكازينو بالتهديدات." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="ادفع، نيفادا",Push,Nevada S01E01 - The Amount
