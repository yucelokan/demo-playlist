#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e01" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="ساعة كولجيت للكوميديا S01E01 - الانتقام بالموسيقى" tvg-logo="https://picsum.photos/seed/1772-the-colgate-comedy-hour-s01e01-revenge-with-music-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1772-the-colgate-comedy-hour-s01e01-revenge-with-music-backdrop/1600/900" tvg-type="series" tvg-genre="تلفزيون التشويق الكلاسيكي" tvg-description="يستضيف إيدي كانتور الحلقة الأولى من المسلسل، وينضم إليه الممثل/الراقص تومي ووندر، ومغنية الأوبرا إيما سوماك، والراقص داني دانيلز، ونجم المسرح اليديشي جوزيف بولوف، ولو هيرن، وروبرت غاري، وجاك ألبرتسون، وفريق الباليه المكون من فال بوتينجنول وجوي ويليامز، وآل جودمان وأوركسترا. تم الترويج للبرنامج في صحيفة نيويورك تايمز باعتباره "مراجعة حنين تستذكر الأيام الذهبية لمسرح نيو أمستردام في برودواي وشارع 42"." tvg-year="1950" tvg-series-title="ساعة كولجيت للكوميديا" tvg-episode-title="الانتقام بالموسيقى" tvg-season="1" tvg-episode="1" group-title="ساعة كولجيت للكوميديا",ساعة كولجيت للكوميديا S01E01 - الانتقام بالموسيقى
