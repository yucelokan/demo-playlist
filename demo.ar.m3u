#EXTINF:-1 tvg-id="live_cinema-channels_07" tvg-name="Cinema HD 7" tvg-logo="https://image.tmdb.org/t/p/w500/xMAmOu6xl4CsstixcuecBle9krd.jpg" tvg-type="live" tvg-genre="قنوات السينما" tvg-description="نورما وآرثر لويس، زوجان من الضواحي ولديهما طفل صغير، يحصلان على صندوق خشبي بسيط كهدية، الأمر الذي يؤدي إلى عواقب وخيمة وغير قابلة للإلغاء. يقوم شخص غريب غامض بتوصيل رسالة مفادها أن الصندوق يعد بمنح مالكه مليون دولار بضغطة زر. لكن الضغط على هذا الزر سيؤدي في نفس الوقت إلى وفاة إنسان آخر في مكان ما من العالم؛ شخص لا يعرفونه. مع وجود الصندوق في حوزتهم لمدة 24 ساعة فقط، تجد نورما وآرثر نفسيهما في مرمى معضلة أخلاقية مذهلة ويجب عليهما مواجهة الطبيعة الحقيقية لإنسانيتهما." group-title="قنوات السينما" tvg-backdrop="https://image.tmdb.org/t/p/w1280/kjVhc1Ba9dFhgsdzQLGKrUbfe1q.jpg",Cinema HD 7
