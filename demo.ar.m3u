#EXTINF:-1 tvg-id="live_documentaries_09" tvg-name="Docu HD 9" tvg-logo="https://image.tmdb.org/t/p/w500/oKZdAUV9XSLp091f0GmtQEu0UZy.jpg" tvg-type="live" tvg-genre="أفلام وثائقية" tvg-description="يخترع اثنان من الخاسرين من ميلووكي، كوب وريمر، لعبة جديدة تجمع بين كرة السلة وقواعد لعبة البيسبول. عندما تحقق اللعبة نجاحًا كبيرًا، يقومون، بمساعدة ملياردير، بتشكيل دوري كرة السلة للمحترفين حيث يحصل الجميع على نفس الأجر ولا يمكن لأي فريق تغيير المدن. عندما يريد مالك منافس إجراء تغييرات كبيرة على القواعد، يكون فريق Coop وRemer هو الوحيد الذي يقف في الطريق." group-title="أفلام وثائقية" tvg-backdrop="https://image.tmdb.org/t/p/w1280/uU4gKojSRMgr7kqpamSh2lFmSIZ.jpg",Docu HD 9
