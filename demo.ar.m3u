#EXTINF:-1 tvg-id="tmdb_movie_10864" tvg-name="Charlie & Louise - Das doppelte Lottchen" tvg-logo="https://image.tmdb.org/t/p/w500/73Qsm9lYqr21n5tMkMWZ0hxAG7l.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/7UUELceq5ZUdUvIuRDqKUwtTBUO.jpg" tvg-type="movie" tvg-genre="عمل عالي الأوكتان" tvg-description="تلتقي الفتاتان شارلوت بالفي ولويز كروجر البالغتان من العمر اثني عشر عامًا في رحلة لغوية إلى اسكتلندا وتكتشفان أنهما توأمان تم فصلهما بعد وقت قصير من الولادة. شارلوت، ابنة مؤلف موسيقي في قاعة الموسيقى، لطيفة وواثقة من نفسها ولطيفة، وترتدي ملابسها وفقًا لذلك وتستمع إلى موسيقى التكنو. لويز، التي نشأت مع والدتها، وهي مديرة إعلانات، ترتدي ملابس "قديمة الطراز"، وهي خجولة ومتحفظة، لكنها تتسم بالضمير والنظام. عاقدة العزم على لعب القدر، يتم تبادل الأدوار - في نهاية الرحلة، تسافر لويز بدور تشارلي إلى والدها، الذي يعمل ملحنًا في برلين-كروزبيرج، بينما تسافر تشارلي بدور لويز إلى والدتها في هامبورغ، حيث تعمل في وكالة إعلانات. تدرك الفتيات أن إعادة والديهن معًا ليس بالأمر السهل كما اعتقدن." tvg-year="1994" tvg-cast="Fritzi Eichhorn, Floriane Eichhorn, Heiner Lauterbach, Corinna Harfouch, Hanns Zischler" tvg-director="Joseph Vilsmaier" group-title="عمل عالي الأوكتان",Charlie & Louise - Das doppelte Lottchen
