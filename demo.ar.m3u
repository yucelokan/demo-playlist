#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_09_s01e01" tvg-series-id="tmdb_tv_1048_slot_09" tvg-name="The Colgate Comedy Hour S01E01 - الحلقة 1" tvg-logo="https://image.tmdb.org/t/p/w500/oWvIOn94vgsrius8HYTreQgJtjp.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/4QrmsUEZgIjzr64MpHprZYEChUN.jpg" tvg-type="series" tvg-genre="Mind-Bending Thrillers" tvg-description="Eddie Cantor hosts the premiere episode of the series, joined by actor/dancer Tommy Wonder, opera soprano Yma Sumac, dancer Danny Daniels, Yiddish theatre star Joseph Buloff, Lew Hearn, Robert Gari, Jack Albertson, the ballet team of Val Buttingnol and Joy Williams, and Al Goodman and his Orchestra. The program was promoted in the NY Times as 'a nostalgic review recalling the halcyon days of the New Amsterdam theater at Broadway and 42nd Street'." tvg-year="1950" tvg-series-title="The Colgate Comedy Hour" tvg-episode-title="الحلقة 1" tvg-season="1" tvg-episode="1" group-title="The Colgate Comedy Hour",The Colgate Comedy Hour S01E01 - الحلقة 1
