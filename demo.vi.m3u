#EXTINF:-1 tvg-id="tmdb_movie_10398" tvg-name="Nguy hiểm gấp đôi" tvg-logo="https://picsum.photos/seed/0077-double-jeopardy-poster/600/900" tvg-backdrop="https://picsum.photos/seed/0077-double-jeopardy-backdrop/1600/900" tvg-type="movie" tvg-genre="Hành động có chỉ số octan cao" tvg-description="Libby Parsons, người bị kết án oan về tội giết chồng Nick, cho rằng anh ấy vẫn còn sống. Cô sống sót sau những năm dài trong tù với hai khát khao cháy bỏng duy trì cuộc sống của mình - tìm thấy con trai và giải quyết bí ẩn đã phá hủy cuộc sống hạnh phúc một thời của cô. Tuy nhiên, đứng giữa cô và nhiệm vụ của cô là sĩ quan tạm tha của cô, Travis Lehman. Libby đặt ra một thách thức cho viên sĩ quan hoài nghi, một thách thức buộc anh ta phải đối mặt với những thất bại của chính mình trong khi đọ sức với cấp trên và các đồng nghiệp thực thi pháp luật, khi cô lao vào một cuộc chiến tuyệt vọng vì công lý, sự sống còn và trả thù." tvg-year="1999" tvg-cast="Ashley Judd, Tommy Lee Jones, Bruce Greenwood, Annabeth Gish, Benjamin Weir" tvg-director="Bruce Beresford" group-title="Hành động có chỉ số octan cao",Nguy hiểm gấp đôi
