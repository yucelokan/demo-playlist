#EXTINF:-1 tvg-id="tmdb_movie_9387" tvg-name="Conan man rợ" tvg-logo="https://picsum.photos/seed/0058-conan-the-barbarian-poster/600/900" tvg-backdrop="https://picsum.photos/seed/0058-conan-the-barbarian-backdrop/1600/900" tvg-type="movie" tvg-genre="Phim kinh dị uốn nắn tâm trí" tvg-description="Một nhóm chiến binh hung hãn đã tàn sát cha mẹ của cậu bé Conan và bắt đứa trẻ làm nô lệ trong nhiều năm trên Bánh xe đau đớn. Là người sống sót duy nhất sau vụ thảm sát thời thơ ấu, Conan được giải thoát khỏi kiếp nô lệ và được dạy nghệ thuật chiến đấu cổ xưa. Biến mình thành một cỗ máy giết chóc, Conan du hành vào vùng hoang dã để tìm cách trả thù Thulsa Doom, kẻ chịu trách nhiệm giết chết gia đình cậu. Ở nơi hoang dã, Conan đối đầu với tên trộm Valeria và Subotai. Cả nhóm gặp Vua Osric, người muốn bộ ba chiến binh giúp giải cứu con gái của ông, người đã cùng Doom trên đồi." tvg-year="1982" tvg-cast="Arnold Schwarzenegger, James Earl Jones, Max von Sydow, Sandahl Bergman, Ben Davidson" tvg-director="John Milius" group-title="Phim kinh dị uốn nắn tâm trí",Conan man rợ
