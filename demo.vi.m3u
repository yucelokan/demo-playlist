#EXTINF:-1 tvg-id="tmdb_tv_2603_slot_38_s01e01" tvg-series-id="tmdb_tv_2603_slot_38" tvg-name="Hex S01E01 - Câu chuyện bắt đầu (1)" tvg-logo="https://picsum.photos/seed/1487-hex-s01e01-the-story-begins-1-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1487-hex-s01e01-the-story-begins-1-backdrop/1600/900" tvg-episode-still="https://image.tmdb.org/t/p/w500/24OnInrQ6kjMVV3GDSrBFVW24JD.jpg" tvg-type="series" tvg-genre="Sê-ri khoa học viễn tưởng cổ điển" tvg-description="Cassie là một học sinh lớp A đang theo học tại một trường nội trú sang trọng tên là Medenham Hall, được xây dựng sau khu buôn bán nô lệ. Khi học kỳ bắt đầu, cô phải chịu đựng những trải nghiệm nhục nhã thường thấy của các bạn cùng lứa nhưng đây là điều cô ít lo lắng nhất. Bị dày vò bởi những hình ảnh bạo lực và bị truy đuổi bởi một người đàn ông bí ẩn, cô nhận ra rằng mình đã phát triển được sức mạnh sẽ thay đổi cuộc đời mình." tvg-year="2004" tvg-cast="Jemima Rooper, Jamie Davis, Laura Pyper, Jemima Abey" tvg-series-title="lục giác" tvg-episode-title="Câu Chuyện Bắt Đầu (1)" tvg-season="1" tvg-episode="1" group-title="lục giác",Hex S01E01 - Câu chuyện bắt đầu (1)
