#EXTINF:-1 tvg-id="tmdb_tv_3845_slot_46_s01e05" tvg-series-id="tmdb_tv_3845_slot_46" tvg-name="Happy Days S01E05 - Hardware Jungle" tvg-logo="https://image.tmdb.org/t/p/w500/sepIwNPCEhkKvFOQSjXK6tekkjR.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/lyAx1XlcrPaenfwvSYnOl4h4WMk.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/jvAXT3l17ARr7TtotiqIV2gEqGa.jpg" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Richie mua vé xem buổi biểu diễn nhạc rock and roll của Fonzie nhưng phải làm việc tại cửa hàng kim khí khi Howard cần cắt bỏ amidan. Vì anh ấy sẽ làm việc đến 9 giờ tối nên không thể đi xem buổi biểu diễn nên anh ấy yêu cầu Fonzie hoàn lại tiền. Sau đó, Howard nói với Richie rằng anh ấy có thể đóng cửa cửa hàng lúc 5 giờ chiều để anh ấy rảnh rỗi đi xem buổi biểu diễn. Bây giờ anh ấy phải yêu cầu Fonzie trả lại vé." tvg-year="1974" tvg-cast="Henry Winkler, Tom Bosley, Marion Ross, Anson Williams, Scott Baio" tvg-series-title="Happy Days" tvg-episode-title="Hardware Jungle" tvg-season="1" tvg-episode="5" group-title="Ngày Hạnh Phúc",Happy Days S01E05 - Hardware Jungle
