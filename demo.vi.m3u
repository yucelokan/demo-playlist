#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_50_s01e02" tvg-series-id="tmdb_tv_2955_slot_50" tvg-name="Push, Nevada S01E02 - The Black Box" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Vụ giết người ở Push khiến Jim phải tìm kiếm manh mối về danh tính của kẻ giết người, nhưng nỗ lực của anh ta bị cản trở bởi cảnh sát trưởng thị trấn và người phó kém hiểu biết của anh ta, những người khẳng định cái chết là một vụ tự sát, mặc dù một nghệ sĩ xăm hình ẩn dật có thể nắm giữ manh mối về kẻ đã phạm tội. Trong khi đó, một nhóm gồm những người đàn ông ăn mặc bảnh bao tự xưng đến từ Ủy ban trò chơi Nevada đến để giải quyết hậu quả của cái chết, và Mary di chuyển để lấy lại chiến lợi phẩm bị đánh cắp." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Black Box" tvg-season="1" tvg-episode="2" group-title="Đẩy, Nevada",Push,Nevada S01E02 - The Black Box
https://download.blender.org/demo/movies/Sintel.2010.720p.mkv

