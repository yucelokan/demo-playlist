#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e01" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="The Colgate Comedy Hour S01E01 - Revenge with Music" tvg-logo="https://image.tmdb.org/t/p/w500/oWvIOn94vgsrius8HYTreQgJtjp.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/4QrmsUEZgIjzr64MpHprZYEChUN.jpg" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Eddie Cantor tổ chức tập đầu tiên của loạt phim, cùng với sự tham gia của nam diễn viên/vũ công Tommy Wonder, giọng nữ cao opera Yma Sumac, vũ công Danny Daniels, ngôi sao sân khấu Yiddish Joseph Buloff, Lew Hearn, Robert Gari, Jack Albertson, đội ba lê của Val Buttingnol và Joy Williams, cùng Al Goodman và dàn nhạc của anh ấy. Chương trình được quảng cáo trên tờ NY Times như "một bài đánh giá hoài niệm gợi lại những ngày tháng thanh bình của nhà hát New Amsterdam ở Broadway và Phố 42"." tvg-year="1950" tvg-series-title="The Colgate Comedy Hour" tvg-episode-title="Revenge with Music" tvg-season="1" tvg-episode="1" group-title="Giờ hài kịch của Colgate",The Colgate Comedy Hour S01E01 - Revenge with Music
