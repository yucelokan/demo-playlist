#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_32_s01e01" tvg-series-id="tmdb_tv_2955_slot_32" tvg-name="Push, Nevada S01E01 - Số tiền" tvg-logo="https://picsum.photos/seed/1298-push-nevada-s01e01-the-amount-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1298-push-nevada-s01e01-the-amount-backdrop/1600/900" tvg-type="series" tvg-genre="Sê-ri khoa học viễn tưởng cổ điển" tvg-description="Khi một số tiền lớn bị đánh cắp từ hầm sòng bạc ở thị trấn sa mạc xa xôi Push, Nevada, đặc vụ IRS Jim Prufrock nhận được tin báo rằng vụ trộm có thể là tham ô nên anh ta đi điều tra.  Tuy nhiên, anh ta không cảm thấy được chào đón vì anh ta được yêu cầu rời khỏi thị trấn hoặc "thực hiện các bước cẩn thận" và cuộc gặp với người quản lý sòng bạc kết thúc bằng những lời đe dọa." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Đẩy, Nevada" tvg-episode-title="Số tiền" tvg-season="1" tvg-episode="1" group-title="Đẩy, Nevada",Push,Nevada S01E01 - Số tiền
