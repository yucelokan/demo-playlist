#EXTINF:-1 tvg-id="tmdb_movie_16222" tvg-name="Bất cứ điều gì nó cần" tvg-logo="https://picsum.photos/seed/0056-whatever-it-takes-poster/600/900" tvg-backdrop="https://picsum.photos/seed/0056-whatever-it-takes-backdrop/1600/900" tvg-type="movie" tvg-genre="Phim kinh dị uốn nắn tâm trí" tvg-description="Một thiếu niên ngổ ngáo, Ryan Woodman phải lòng Ashley Grant nổi tiếng và xinh đẹp, người dường như không có hứng thú với anh ta. Trong khi đó, vận động viên ngôi sao mờ mịt Chris Campbell để mắt tới cô bạn xinh đẹp và thông minh của Ryan, Maggie Carter. Cả hai đồng ý giúp đỡ nhau trong hành trình lãng mạn, nhưng khi họ tiến gần hơn đến mục tiêu của mình, cả Ryan và Chris đều nghi ngờ rằng họ có thể đang theo đuổi nhầm cô gái." tvg-year="2000" tvg-cast="Jodi Lyn O'Keefe, Shane West, Marla Sokoloff, James Franco, Aaron Paul" tvg-director="David Raynr" group-title="Phim kinh dị uốn nắn tâm trí",Bất cứ điều gì nó cần
