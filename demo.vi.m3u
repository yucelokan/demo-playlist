#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_50_s01e01" tvg-series-id="tmdb_tv_2955_slot_50" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Khi một số tiền lớn bị đánh cắp từ hầm sòng bạc ở thị trấn sa mạc xa xôi Push, Nevada, đặc vụ IRS Jim Prufrock nhận được tin báo rằng vụ trộm có thể là tham ô nên anh ta đi điều tra.  Tuy nhiên, anh ta không cảm thấy được chào đón vì anh ta được yêu cầu rời khỏi thị trấn hoặc "thực hiện các bước cẩn thận" và cuộc gặp với người quản lý sòng bạc kết thúc bằng những lời đe dọa." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="Đẩy, Nevada",Push,Nevada S01E01 - The Amount
