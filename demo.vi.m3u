#EXTINF:-1 tvg-id="tmdb_tv_2603_slot_20_s01e01" tvg-series-id="tmdb_tv_2603_slot_20" tvg-name="Hex S01E01 - The Story Begins (1)" tvg-logo="https://image.tmdb.org/t/p/w500/rYaZSE48K6usylHfC6QKsFChXmx.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/bihkhvuMZ510JnsUIgmzUTSqiLF.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/24OnInrQ6kjMVV3GDSrBFVW24JD.jpg" tvg-type="series" tvg-genre="Tập tin bí ẩn đen tối" tvg-description="Cassie là một học sinh lớp A đang theo học tại một trường nội trú sang trọng tên là Medenham Hall, được xây dựng sau khu buôn bán nô lệ. Khi học kỳ bắt đầu, cô phải chịu đựng những trải nghiệm nhục nhã thường thấy của các bạn cùng lứa nhưng đây là điều cô ít lo lắng nhất. Bị dày vò bởi những hình ảnh bạo lực và bị truy đuổi bởi một người đàn ông bí ẩn, cô nhận ra rằng mình đã phát triển được sức mạnh sẽ thay đổi cuộc đời mình." tvg-year="2004" tvg-cast="Jemima Rooper, Jamie Davis, Laura Pyper, Jemima Abey" tvg-series-title="Hex" tvg-episode-title="The Story Begins (1)" tvg-season="1" tvg-episode="1" group-title="lục giác",Hex S01E01 - The Story Begins (1)
