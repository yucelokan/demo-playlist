#EXTINF:-1 tvg-id="tmdb_tv_3950_slot_33_s01e01" tvg-series-id="tmdb_tv_3950_slot_33" tvg-name="Bạn sẽ làm gì? S01E01 - Tập 1" tvg-logo="https://picsum.photos/seed/1305-what-would-you-do-s01e01-ep-1-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1305-what-would-you-do-s01e01-ep-1-backdrop/1600/900" tvg-type="series" tvg-genre="Sê-ri khoa học viễn tưởng cổ điển" tvg-description="Bạn sẽ làm gì? là một chương trình truyền hình dài 30 phút do Marc Summers tổ chức được chiếu trên Nickelodeon từ năm 1991 đến năm 1993. Robin Marrella đóng vai trò là người dẫn chương trình trước máy quay cho mùa đầu tiên của chương trình. Cả Summers và Marrella đều thực hiện nhiệm vụ tương ứng của mình trên Double Dare, cũng như trên Nickelodeon. Chương trình được sản xuất tại Nickelodeon Studios tại Universal Studios ở Florida; một số phân đoạn ban đầu được sản xuất tại Universal Studios ở Hollywood." tvg-year="1991" tvg-cast="Dee Bradley Baker, Marc Summers" tvg-series-title="Bạn sẽ làm gì?" tvg-episode-title="Tập 1" tvg-season="1" tvg-episode="1" group-title="Bạn sẽ làm gì?",Bạn sẽ làm gì? S01E01 - Tập 1
