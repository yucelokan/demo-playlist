#EXTINF:-1 tvg-id="tmdb_tv_2603_slot_47_s01e05" tvg-series-id="tmdb_tv_2603_slot_47" tvg-name="Hex S01E05 - Possession" tvg-logo="https://image.tmdb.org/t/p/w500/rYaZSE48K6usylHfC6QKsFChXmx.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/bihkhvuMZ510JnsUIgmzUTSqiLF.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/4hbKCosMc0V4YHaKVVWzYUr9sYU.jpg" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Không còn nghi ngờ gì nữa, Cassie đã thay đổi. Cô ấy mặc quần áo bó sát gợi cảm; cô ấy có thái độ thù địch với Thelma và tỏ ra thái độ. Cô hầu như không để ý đến Troy trẻ tuổi nhưng điều đó chỉ khiến anh càng khao khát được ở bên cô hơn. Bạn bè của anh ấy không thể hiểu tại sao anh ấy lại cho phép mình bị đối xử theo cách này nhưng anh ấy không thể cưỡng lại cô ấy." tvg-year="2004" tvg-cast="Jemima Rooper, Jamie Davis, Laura Pyper, Jemima Abey" tvg-series-title="Hex" tvg-episode-title="Possession" tvg-season="1" tvg-episode="5" group-title="lục giác",Hex S01E05 - Possession
