#EXTINF:-1 tvg-id="tmdb_movie_22825" tvg-name="The Box" tvg-logo="https://image.tmdb.org/t/p/w500/xMAmOu6xl4CsstixcuecBle9krd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/kjVhc1Ba9dFhgsdzQLGKrUbfe1q.jpg" tvg-type="movie" tvg-genre="Hành động có chỉ số octan cao" tvg-description="Norma và Arthur Lewis, một cặp vợ chồng ở ngoại ô có một đứa con nhỏ, nhận được một món quà là một chiếc hộp gỗ đơn giản, mang theo những hậu quả chết người và không thể thay đổi được. Một người lạ bí ẩn đưa ra thông điệp rằng chiếc hộp hứa sẽ mang lại cho chủ nhân của nó 1 triệu USD chỉ bằng một nút bấm. Tuy nhiên, nhấn nút này sẽ đồng thời gây ra cái chết cho một người khác ở đâu đó trên thế giới; một người nào đó mà họ không biết. Chỉ với 24 giờ để sở hữu chiếc hộp, Norma và Arthur thấy mình đang ở trong tình thế khó xử về đạo đức đáng kinh ngạc và phải đối mặt với bản chất thực sự của con người họ." tvg-year="2009" tvg-cast="Cameron Diaz, James Marsden, Frank Langella, James Rebhorn, Holmes Osborne" tvg-director="Richard Kelly" group-title="Hành động có chỉ số octan cao",The Box
