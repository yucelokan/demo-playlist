#EXTINF:-1 tvg-id="tmdb_tv_3950_slot_42_s01e01" tvg-series-id="tmdb_tv_3950_slot_42" tvg-name="What Would You Do? S01E01 - Ep 1" tvg-logo="https://image.tmdb.org/t/p/w500/wJpMr0EDbgQFI1SSy77z5Yuau2.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/mFyO7B45TeeL8f6fWENr3oRLthL.jpg" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Bạn sẽ làm gì? là một chương trình truyền hình dài 30 phút do Marc Summers tổ chức được chiếu trên Nickelodeon từ năm 1991 đến năm 1993. Robin Marrella đóng vai trò là người dẫn chương trình trước máy quay cho mùa đầu tiên của chương trình. Cả Summers và Marrella đều thực hiện nhiệm vụ tương ứng của mình trên Double Dare, cũng như trên Nickelodeon. Chương trình được sản xuất tại Nickelodeon Studios tại Universal Studios ở Florida; một số phân đoạn ban đầu được sản xuất tại Universal Studios ở Hollywood." tvg-year="1991" tvg-cast="Dee Bradley Baker, Marc Summers" tvg-series-title="What Would You Do?" tvg-episode-title="Ep 1" tvg-season="1" tvg-episode="1" group-title="Bạn sẽ làm gì?",What Would You Do? S01E01 - Ep 1
