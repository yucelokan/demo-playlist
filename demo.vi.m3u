#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e02" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="Giờ hài kịch Colgate S01E02 - Hãy đối mặt với nó" tvg-logo="https://picsum.photos/seed/1773-the-colgate-comedy-hour-s01e02-let-s-face-it-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1773-the-colgate-comedy-hour-s01e02-let-s-face-it-backdrop/1600/900" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Được tổ chức bởi Dean Martin và Jerry Lewis, có Dean và Jerry cùng với Marilyn Maxwell xinh đẹp ("The Lemon Drop Kid") và diễn viên hài Leonard Barr. Các bản phác thảo bao gồm một đoạn hậu trường với cảnh Martin và Lewis đi loanh quanh trong phòng thay đồ của họ, và một đoạn khác với cảnh Jerry đóng vai một đứa trẻ đi xem phim với Dean đã trưởng thành." tvg-year="1950" tvg-series-title="Giờ hài kịch của Colgate" tvg-episode-title="Hãy đối mặt với nó" tvg-season="1" tvg-episode="2" group-title="Giờ hài kịch của Colgate",Giờ hài kịch Colgate S01E02 - Hãy đối mặt với nó
