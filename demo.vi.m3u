#EXTINF:-1 tvg-id="tmdb_tv_1048_slot_45_s01e01" tvg-series-id="tmdb_tv_1048_slot_45" tvg-name="Giờ hài kịch Colgate S01E01 - Trả thù bằng âm nhạc" tvg-logo="https://picsum.photos/seed/1772-the-colgate-comedy-hour-s01e01-revenge-with-music-poster/600/900" tvg-backdrop="https://picsum.photos/seed/1772-the-colgate-comedy-hour-s01e01-revenge-with-music-backdrop/1600/900" tvg-type="series" tvg-genre="Truyền hình hồi hộp cổ điển" tvg-description="Eddie Cantor tổ chức tập đầu tiên của loạt phim, cùng với sự tham gia của nam diễn viên/vũ công Tommy Wonder, giọng nữ cao opera Yma Sumac, vũ công Danny Daniels, ngôi sao sân khấu Yiddish Joseph Buloff, Lew Hearn, Robert Gari, Jack Albertson, đội ba lê của Val Buttingnol và Joy Williams, cùng Al Goodman và dàn nhạc của anh ấy. Chương trình được quảng cáo trên tờ NY Times như "một bài đánh giá hoài niệm gợi lại những ngày tháng thanh bình của nhà hát New Amsterdam ở Broadway và Phố 42"." tvg-year="1950" tvg-series-title="Giờ hài kịch của Colgate" tvg-episode-title="Trả thù bằng âm nhạc" tvg-season="1" tvg-episode="1" group-title="Giờ hài kịch của Colgate",Giờ hài kịch Colgate S01E01 - Trả thù bằng âm nhạc
