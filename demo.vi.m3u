#EXTINF:-1 tvg-id="tmdb_movie_10864" tvg-name="Charlie & Louise - Das doppelte Lottchen" tvg-logo="https://image.tmdb.org/t/p/w500/73Qsm9lYqr21n5tMkMWZ0hxAG7l.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/7UUELceq5ZUdUvIuRDqKUwtTBUO.jpg" tvg-type="movie" tvg-genre="Hành động có chỉ số octan cao" tvg-description="Hai cô bé 12 tuổi Charlotte Palfy và Louise Kröger gặp nhau trong một chuyến du lịch ngôn ngữ đến Scotland và phát hiện ra rằng họ là một cặp song sinh bị chia cắt ngay sau khi sinh. Charlotte, con gái của một nhà soạn nhạc trong hội trường âm nhạc, rất ngầu, tự tin và táo bạo, ăn mặc phù hợp và nghe nhạc techno. Louise, lớn lên cùng mẹ, một giám đốc quảng cáo, mặc quần áo 'lỗi thời' hơn, nhút nhát và dè dặt nhưng tận tâm và ngăn nắp. Quyết tâm đóng vai số phận, hai người hoán đổi vai trò - ở cuối cuộc hành trình, Louise đi với tư cách là Charlie đến gặp cha cô, người làm nhà soạn nhạc ở Berlin-Kreuzberg, trong khi Charlie đi với tư cách là Louise đến gặp mẹ cô ở Hamburg, nơi cô làm việc trong một công ty quảng cáo. Các cô gái nhận ra rằng việc đưa bố mẹ quay lại với nhau không hề dễ dàng như họ nghĩ." tvg-year="1994" tvg-cast="Fritzi Eichhorn, Floriane Eichhorn, Heiner Lauterbach, Corinna Harfouch, Hanns Zischler" tvg-director="Joseph Vilsmaier" group-title="Hành động có chỉ số octan cao",Charlie & Louise - Das doppelte Lottchen
