#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_41_s01e01" tvg-series-id="tmdb_tv_2955_slot_41" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Klassisches Suspense-TV" tvg-description="Als in der abgelegenen Wüstenstadt Push in Nevada eine große Geldsumme aus dem Tresorraum eines Kasinos gestohlen wird, bekommt der IRS-Agent Jim Prufrock einen Hinweis, dass es sich bei dem Diebstahl um Unterschlagung handeln könnte, und macht sich auf die Suche.  Man gibt ihm jedoch nicht das Gefühl, willkommen zu sein, da ihm gesagt wird, er solle entweder die Stadt verlassen oder „vorsichtige Schritte unternehmen“, und ein Treffen mit dem Casino-Manager endet mit Drohungen." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="Push, Nevada",Push,Nevada S01E01 - The Amount
