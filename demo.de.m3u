#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_45_s01e17" tvg-series-id="tmdb_tv_4515_slot_45" tvg-name="Superman - Die Abenteuer von Lois & Clark S01E17 - Rivalinnen" tvg-logo="https://image.tmdb.org/t/p/w500/1LbPs6i1h4BKjVUwK5S9GjPCydi.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/4poYCSuU4ZP5l9IIFV5IfCGCDfT.jpg" tvg-type="series" tvg-genre="Classic Suspense TV" tvg-description="Linda King, eine Ex-Kommilitonin und ewige Rivalin von Lois, heuert beim Metropolis Star an. Das Konkurrenzblatt zieht plötzlich mit sensationellen Stories am Daily Planet vorbei. Linda scheint sogar Clark zum Wechsel in die Redaktion des Star bewegen zu können." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Superman - Die Abenteuer von Lois & Clark" tvg-episode-title="Rivalinnen" tvg-season="1" tvg-episode="17" group-title="Superman - Die Abenteuer von Lois & Clark",Superman - Die Abenteuer von Lois & Clark S01E17 - Rivalinnen
