#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_18_s01e03" tvg-series-id="tmdb_tv_4515_slot_18" tvg-name="Superman - Die Abenteuer von Lois & Clark S01E03 - Wer anderen eine Story klaut …" tvg-logo="https://image.tmdb.org/t/p/w500/1LbPs6i1h4BKjVUwK5S9GjPCydi.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/AprdtHEckkQF0VuKo9gdDMZkSQe.jpg" tvg-type="series" tvg-genre="Dark Mystery Files" tvg-description="Lex Luthor will herausfinden, wie stark Superman wirklich ist. Er provoziert ständig neue Unglücksfälle. Da Clark nicht alle verhindern kann, ist er drauf und dran aufgeben. Zu allem Überfluss schnappt Lois ihm auch noch seine Story weg." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Superman - Die Abenteuer von Lois & Clark" tvg-episode-title="Wer anderen eine Story klaut …" tvg-season="1" tvg-episode="3" group-title="Superman - Die Abenteuer von Lois & Clark",Superman - Die Abenteuer von Lois & Clark S01E03 - Wer anderen eine Story klaut …
