#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_05_s01e02" tvg-series-id="tmdb_tv_2955_slot_05" tvg-name="Push, Nevada S01E02 – Die Black Box" tvg-logo="https://picsum.photos/seed/0270-push-nevada-s01e02-the-black-box-poster/600/900" tvg-backdrop="https://picsum.photos/seed/0270-push-nevada-s01e02-the-black-box-backdrop/1600/900" tvg-type="series" tvg-genre="Umwerfende Thriller" tvg-description="Der Mord in Push veranlasst Jim, nach Hinweisen auf die Identität des Mörders zu suchen, doch seine Bemühungen werden durch den Stadtsheriff und seinen dämlichen Stellvertreter behindert, die darauf bestehen, dass es sich bei dem Tod um Selbstmord handelte, obwohl ein zurückgezogen lebender Tätowierer möglicherweise einen Hinweis darauf hat, wer das Verbrechen begangen hat. Unterdessen trifft ein Team gut gekleideter Männer, die angeblich von der Nevada Gaming Commission stammen, ein, um sich um die Folgen des Todes zu kümmern, und Mary macht sich auf den Weg, um die gestohlene Beute zurückzuholen." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="Die Blackbox" tvg-season="1" tvg-episode="2" group-title="Push, Nevada",Push,Nevada S01E02 – Die Black Box
