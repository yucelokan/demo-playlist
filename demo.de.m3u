#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_05_s01e01" tvg-series-id="tmdb_tv_2955_slot_05" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Umwerfende Thriller" tvg-description="Als in der abgelegenen Wüstenstadt Push in Nevada eine große Geldsumme aus dem Tresorraum eines Kasinos gestohlen wird, bekommt der IRS-Agent Jim Prufrock einen Hinweis, dass es sich bei dem Diebstahl um Unterschlagung handeln könnte, und macht sich auf die Suche.  Man gibt ihm jedoch nicht das Gefühl, willkommen zu sein, da ihm gesagt wird, er solle entweder die Stadt verlassen oder „vorsichtige Schritte unternehmen“, und ein Treffen mit dem Casino-Manager endet mit Drohungen." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="Push, Nevada",Push,Nevada S01E01 - The Amount
https://download.blender.org/demo/movies/Sintel.2010.720p.mkv

#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_05_s01e02" tvg-series-id="tmdb_tv_2955_slot_05" tvg-name="Push, Nevada S01E02 - The Black Box" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Umwerfende Thriller" tvg-description="Der Mord in Push veranlasst Jim, nach Hinweisen auf die Identität des Mörders zu suchen, doch seine Bemühungen werden durch den Stadtsheriff und seinen dämlichen Stellvertreter behindert, die darauf bestehen, dass es sich bei dem Tod um Selbstmord handelte, obwohl ein zurückgezogen lebender Tätowierer möglicherweise einen Hinweis darauf hat, wer das Verbrechen begangen hat. Unterdessen trifft ein Team gut gekleideter Männer, die angeblich von der Nevada Gaming Commission stammen, ein, um sich um die Folgen des Todes zu kümmern, und Mary macht sich auf den Weg, um die gestohlene Beute zurückzuholen." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Black Box" tvg-season="1" tvg-episode="2" group-title="Push, Nevada",Push,Nevada S01E02 - The Black Box
