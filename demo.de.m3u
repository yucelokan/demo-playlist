#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_18_s01e06" tvg-series-id="tmdb_tv_4515_slot_18" tvg-name="Superman - Die Abenteuer von Lois & Clark S01E06 - Die Feuerteufel" tvg-logo="https://image.tmdb.org/t/p/w500/1LbPs6i1h4BKjVUwK5S9GjPCydi.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/rVSY8FsDBNPCpxuDEmOaRrgqg61.jpg" tvg-type="series" tvg-genre="Dark Mystery Files" tvg-description="Im Stadtteil West River ereignet sich eine Serie von Brandanschlägen. Einer Spur folgend, arbeitet Lois als Kellnerin im verrufenen Metro-Club. Auch Clark heuert bei Metro-Chefin Toni an. Gemeinsam geraten sie mitten in die Machtkämpfe der Mafia." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Superman - Die Abenteuer von Lois & Clark" tvg-episode-title="Die Feuerteufel" tvg-season="1" tvg-episode="6" group-title="Superman - Die Abenteuer von Lois & Clark",Superman - Die Abenteuer von Lois & Clark S01E06 - Die Feuerteufel
