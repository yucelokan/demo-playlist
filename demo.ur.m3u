#EXTINF:-1 tvg-id="live_documentaries_04" tvg-name="Docu HD 4" tvg-logo="https://image.tmdb.org/t/p/w500/uWWGVspUqMezWpXcaaB3yglWp8F.jpg" tvg-type="live" tvg-genre="دستاویزی فلمیں" tvg-description="ڈیتھ اسٹالکر رینا دی سیئر کی چند جاموں سے مدد کرتا ہے، اور وہ ایک بڑے کام کے لیے اس سے مدد مانگتی ہے۔ اس نے انکشاف کیا کہ وہ دراصل شہزادی ایوی ہے، لیکن شیطانی جادوگر نے بادشاہی پر قبضہ کرنے کے لیے اسے اغوا کر کے کلون کیا تھا۔ وہ مل کر شہزادی کو اس کے صحیح مقام پر بحال کرنے کے لیے شیطانی جادوگر کے گڑھ کا سفر کرتے ہیں، راستے میں جادوگروں کے غنڈوں اور ایمیزون کی شدید خواتین دونوں کی طرف سے چیلنجوں کا سامنا کرنا پڑتا ہے۔" group-title="دستاویزی فلمیں" tvg-backdrop="https://image.tmdb.org/t/p/w1280/bDFayg4joYfc21ynNKmRIJZKx6M.jpg",Docu HD 4
