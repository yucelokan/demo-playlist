#EXTINF:-1 tvg-id="tmdb_movie_9761" tvg-name="हाथी सपना" tvg-logo="https://image.tmdb.org/t/p/w500/9zROtU9TkpZQrOuEaMAp68FOWLK.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/9bJDwuhza19HQcYA99FeslLYmUm.jpg" tvg-type="movie" tvg-genre="रेट्रो साइंस-फाई क्लासिक्स" tvg-description="एलीफैंट्स ड्रीम दो अजीब पात्रों की कहानी है जो एक सनकी और प्रतीत होने वाली अनंत मशीन की खोज करते हैं। बुजुर्ग, प्रोग, एक टूर-गाइड और रक्षक के रूप में कार्य करता है, खुशी-खुशी अपने शुरू में जिज्ञासु लेकिन तेजी से संदेह करने वाले शिष्य इमो को मशीन के दृश्य और खतरे दिखाता है। जैसे-जैसे उनकी यात्रा आगे बढ़ती है, हमें संकेत मिलते हैं कि मशीन वह सब नहीं है जो प्रोग सोचता है, और उसका मार्गदर्शन एक और अधिक निराशाजनक पहलू पर ले जाता है।  एलीफैंट्स ड्रीम संचार और कल्पना के बारे में एक कहानी है, जिसे उद्देश्यपूर्ण ढंग से दुनिया की पहली 3डी एनिमेटेड "ओपन मूवी" के रूप में बनाया गया है। फ़िल्म को क्रिएटिव कॉमन्स लाइसेंस के तहत रिलीज़ किया गया है, साथ ही इसे बनाने में उपयोग की गई संपूर्ण उत्पादन फ़ाइलें (लगभग 7 गीगाबाइट डेटा) भी शामिल हैं। मूवी बनाने के लिए उपयोग किया जाने वाला सॉफ़्टवेयर अन्य ओपन सोर्स सॉफ़्टवेयर के साथ-साथ फ्री/ओपन सोर्स एनीमेशन सूट ब्लेंडर है, इस प्रकार मूवी को केवल एक कंप्यूटर और डीवीडी या डाउनलोड पर डेटा के साथ रीमेक, रीमिक्स और पुन: उपयोग करने की अनुमति मिलती है।" tvg-year="2006" tvg-cast="Tygo Gernandt, Cas Jansen" tvg-director="Bassam Kurdali" group-title="रेट्रो साइंस-फाई क्लासिक्स",हाथी सपना
