#EXTINF:-1 tvg-id="live_cinema-channels_08" tvg-name="दोहरा ख़तरा" tvg-logo="https://image.tmdb.org/t/p/w500/dPd9QvEeMQpgHO6iLB1LqALTZl.jpg" tvg-type="live" tvg-genre="सिनेमा चैनल" tvg-description="अपने पति निक की हत्या के लिए गलत तरीके से दोषी ठहराई गई लिब्बी पार्सन्स सोचती है कि वह अभी भी जीवित है। वह दो ज्वलंत इच्छाओं के साथ जेल में लंबे वर्षों तक जीवित रही - अपने बेटे को ढूंढना और उस रहस्य को सुलझाना जिसने उसके एक बार के खुशहाल जीवन को नष्ट कर दिया। हालाँकि, उसके और उसकी खोज के बीच में उसका पैरोल अधिकारी, ट्रैविस लेहमैन खड़ा है। लिब्बी सनकी अधिकारी के लिए एक चुनौती पेश करती है, जो उसे अपने वरिष्ठ और कानून प्रवर्तन सहयोगियों के खिलाफ खड़ा करते हुए अपनी विफलताओं का सामना करने के लिए मजबूर करती है, क्योंकि वह न्याय, अस्तित्व और बदला लेने के लिए एक हताश लड़ाई में उतर जाती है।" group-title="सिनेमा चैनल" tvg-backdrop="https://image.tmdb.org/t/p/w1280/fk4NXhazfRKtQaVEV9IPeM7OIVH.jpg",दोहरा ख़तरा
