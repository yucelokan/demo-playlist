#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_32_s01e02" tvg-series-id="tmdb_tv_2955_slot_32" tvg-name="पुश, नेवादा S01E02 - ब्लैक बॉक्स" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="रेट्रो विज्ञान-फाई धारावाहिक" tvg-description="पुश में हत्या जिम को हत्यारे की पहचान के लिए सुराग ढूंढने के लिए प्रेरित करती है, लेकिन उसके प्रयासों में शहर के शेरिफ और उसके मंदबुद्धि डिप्टी द्वारा बाधा डाली जाती है, जो इस बात पर जोर देते हैं कि मौत एक आत्महत्या थी, हालांकि एक एकांतप्रिय टैटू कलाकार इस बात का सुराग लगा सकता है कि अपराध किसने किया। इस बीच, नेवादा गेमिंग कमीशन से होने का दावा करने वाले अच्छे कपड़े पहने लोगों की एक टीम मौत के परिणामों से निपटने के लिए आती है, और मैरी चोरी की गई लूट को वापस पाने के लिए आगे बढ़ती है।" tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="पुश, नेवादा" tvg-episode-title="ब्लैक बॉक्स" tvg-season="1" tvg-episode="2" group-title="पुश, नेवादा",Push,नेवादा S01E02 - ब्लैक बॉक्स
