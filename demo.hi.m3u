#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_32_s01e01" tvg-series-id="tmdb_tv_2955_slot_32" tvg-name="पुश, नेवादा S01E01 - राशि" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="रेट्रो विज्ञान-फाई धारावाहिक" tvg-description="जब नेवादा के सुदूर रेगिस्तानी शहर पुश में एक कैसीनो वॉल्ट से बड़ी मात्रा में पैसे चोरी हो जाते हैं, तो आईआरएस एजेंट जिम प्रुफ्रॉक को एक सूचना मिलती है कि चोरी का गबन हो सकता है, इसलिए वह जांच करने जाता है।  हालाँकि, उसका स्वागत नहीं किया जाता है, क्योंकि उसे या तो शहर से बाहर जाने या ''सावधानीपूर्वक कदम उठाने'' के लिए कहा जाता है, और कैसीनो प्रबंधक के साथ बैठक धमकियों के साथ समाप्त होती है।" tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="पुश, नेवादा" tvg-episode-title="राशि" tvg-season="1" tvg-episode="1" group-title="पुश, नेवादा",Push,नेवादा S01E01 - राशि
