#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_05_s01e01" tvg-series-id="tmdb_tv_2955_slot_05" tvg-name="Push, Nevada S01E01 - Aflevering 1" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Mind-Bending Thrillers" tvg-description="When a large amount of money is stolen from a casino vault in the remote desert town of Push, Nevada, IRS agent Jim Prufrock gets a tip that the theft could be embezzlement, so he goes to investigate.  He's not made to feel welcome, however, as he is told either to get out of town or ''take careful steps,'' and a meeting with the casino manager ends with threats." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="Aflevering 1" tvg-season="1" tvg-episode="1" group-title="Push, Nevada",Push, Nevada S01E01 - Aflevering 1
