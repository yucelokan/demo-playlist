#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_23_s01e01" tvg-series-id="tmdb_tv_2955_slot_23" tvg-name="Push, Nevada S01E01 - The Amount" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Actie met hoog octaangehalte" tvg-description="Wanneer een grote hoeveelheid geld wordt gestolen uit een casinokluis in het afgelegen woestijnstadje Push, Nevada, krijgt IRS-agent Jim Prufrock een tip dat de diefstal mogelijk verduistering is, dus gaat hij op onderzoek uit.  Hij voelt zich echter niet welkom, omdat hem wordt verteld de stad te verlaten of 'voorzichtige stappen te ondernemen', en een ontmoeting met de casinomanager eindigt met bedreigingen." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="The Amount" tvg-season="1" tvg-episode="1" group-title="Duw, Nevada",Push,Nevada S01E01 - The Amount
