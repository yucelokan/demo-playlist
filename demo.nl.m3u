#EXTINF:-1 tvg-id="tmdb_tv_3845_slot_48_s01e05" tvg-series-id="tmdb_tv_3845_slot_48" tvg-name="Happy Days S01E05 - Hardware Jungle" tvg-logo="https://image.tmdb.org/t/p/w500/sepIwNPCEhkKvFOQSjXK6tekkjR.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/lyAx1XlcrPaenfwvSYnOl4h4WMk.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/jvAXT3l17ARr7TtotiqIV2gEqGa.jpg" tvg-type="series" tvg-genre="Classic Suspense TV" tvg-description="Richie buys tickets to a rock and roll show from Fonzie but has to work at the hardware store when Howard needs to have his tonsils removed. Because he'll be working until 9:00 PM, he won't be able to go to the show, so he asks Fonzie for a refund. Later, Howard tells Richie that he can close the store at 5:00 PM leaving him free to go to the show. He, now, has to ask Fonzie for the tickets back." tvg-year="1974" tvg-cast="Henry Winkler, Tom Bosley, Marion Ross, Anson Williams, Scott Baio" tvg-series-title="Happy Days" tvg-episode-title="Hardware Jungle" tvg-season="1" tvg-episode="5" group-title="Happy Days",Happy Days S01E05 - Hardware Jungle
