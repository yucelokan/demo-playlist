#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_41_s01e02" tvg-series-id="tmdb_tv_2955_slot_41" tvg-name="Push, Nevada S01E02 – Czarna skrzynka" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Klasyczny telewizor suspensowy" tvg-description="Morderstwo w Push sprawia, że Jim szuka wskazówek co do tożsamości zabójcy, ale jego wysiłki utrudniają miejski szeryf i jego tępy zastępca, którzy upierają się, że śmierć była samobójstwem, chociaż samotny tatuator może posiadać wskazówkę, kto popełnił przestępstwo. Tymczasem grupa dobrze ubranych mężczyzn podających się za członków Komisji ds. Gier Nevady przybywa, aby uporać się z konsekwencjami śmierci, a Mary postanawia odzyskać skradziony łup." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Pchnij, Nevada" tvg-episode-title="Czarna skrzynka" tvg-season="1" tvg-episode="2" group-title="Pchnij, Nevada",Push,Nevada S01E02 – Czarna skrzynka
