#EXTINF:-1 tvg-id="live_documentaries_01" tvg-name="Dokument HD 1" tvg-logo="https://image.tmdb.org/t/p/w500/nIp4gIXogCjfB1QABNsWwa9gSca.jpg" tvg-type="live" tvg-genre="Filmy dokumentalne" tvg-description="Podczas wojny secesyjnej w Ameryce szpiedzy z Unii kradną ukochaną lokomotywę inżyniera Johnny'ego Graya, „Generał” – z ukochaną Johnniego na pokładzie przyczepionego wagonu – a on w pojedynkę musi zrobić wszystko, co w jego mocy, aby odzyskać Generała i uratować Annabelle." group-title="Filmy dokumentalne" tvg-backdrop="https://image.tmdb.org/t/p/w1280/mzox4HbcV9W42MH2dB1QsdDVGo3.jpg",Dokument HD 1
