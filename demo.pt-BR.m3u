#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_23_s01e01" tvg-series-id="tmdb_tv_2955_slot_23" tvg-name="Push, Nevada S01E01 - A Quantidade" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Ação de alta octanagem" tvg-description="Quando uma grande quantia de dinheiro é roubada de um cofre de cassino na remota cidade desértica de Push, Nevada, o agente do IRS Jim Prufrock recebe uma denúncia de que o roubo pode ser um desfalque, então ele vai investigar.  No entanto, ele não se sente bem-vindo, pois é instruído a sair da cidade ou “tomar medidas cuidadosas”, e uma reunião com o gerente do cassino termina com ameaças." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Empurre, Nevada" tvg-episode-title="A quantidade" tvg-season="1" tvg-episode="1" group-title="Empurre, Nevada",Push,Nevada S01E01 - A Quantidade
