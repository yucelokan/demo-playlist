#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_11_s01e08" tvg-series-id="tmdb_tv_4515_slot_11" tvg-name="Lois & Clark - Le nuove avventure di Superman S01E08 - Ritorno a casa" tvg-logo="https://image.tmdb.org/t/p/w500/cKQ2yTmCyubxXPcWPLaW4lvYbgA.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/etYhbQsE8jLvNNVQdKLeHnGRx1B.jpg" tvg-type="series" tvg-genre="Dark Mystery Files" tvg-description="Lois e Clark indagano su una vicenda sospetta che coinvolge l'Agenzia di protezione dell'ambiente a Smallville. Ma non sono tossine create dall'uomo quello che gli agenti federali stanno cercando, bensì un pezzo di kryptonite, la sostanza che può sottrarre a Superman i suoi poteri o persino la sua vita." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Lois & Clark - Le nuove avventure di Superman" tvg-episode-title="Ritorno a casa" tvg-season="1" tvg-episode="8" group-title="Lois & Clark - Le nuove avventure di Superman",Lois & Clark - Le nuove avventure di Superman S01E08 - Ritorno a casa
https://download.blender.org/demo/movies/Sintel.2010.720p.mkv

#EXTINF:-1 tvg-id="tmdb_tv_4515_slot_11_s01e09" tvg-series-id="tmdb_tv_4515_slot_11" tvg-name="Lois & Clark - Le nuove avventure di Superman S01E09 - L'uomo venuto dallo spazio" tvg-logo="https://image.tmdb.org/t/p/w500/cKQ2yTmCyubxXPcWPLaW4lvYbgA.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/2gzPDDhpP86MACQOu5aQg9DKyUc.jpg" tvg-episode-still="https://image.tmdb.org/t/p/w500/wavHY6nTitGKrZQXT6AOwx1nDqx.jpg" tvg-type="series" tvg-genre="Dark Mystery Files" tvg-description="Quando in pieno inverno Metropolis viene investita da un'anomala ondata di calore, i cittadini incolpano i poteri di Superman, il quale decide di lasciare la città per salvarla e permettere a Lois di indagare sulla vera ragione di quel caldo." tvg-year="1993" tvg-cast="Dean Cain, Teri Hatcher, Lane Smith, Justin Whalin, K Callan" tvg-series-title="Lois & Clark - Le nuove avventure di Superman" tvg-episode-title="L'uomo venuto dallo spazio" tvg-season="1" tvg-episode="9" group-title="Lois & Clark - Le nuove avventure di Superman",Lois & Clark - Le nuove avventure di Superman S01E09 - L'uomo venuto dallo spazio
