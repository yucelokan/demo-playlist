#EXTINF:-1 tvg-id="tmdb_movie_22965" tvg-name="Condamné à Mort" tvg-logo="https://image.tmdb.org/t/p/w500/fZM1TXUismtG2D5OouYhncceTYL.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/c9k3Am0QhRhTGJQsDVfcbxeF0lJ.jpg" tvg-type="movie" tvg-genre="High-Octane Action" tvg-description="magnat de l'expédition Cyrus Wentworth, baissés sur une catastrophe à son paquebot « Wentworth Castle » (portant, assez curieusement, une cargaison illicite d'obligations chinoises) est abattu dans son bureau ... au moment même de coups de pied le fiancé de sa fille Dick Fleming . Bien sûr, le capitaine arrête la rue Dick, mais journaliste Bobbie Logan, l'épine attrayante dans le côté de la rue, est tellement convaincu qu'il a tort qu'elle fait appel à l'aide de détective James Lee Wong pour trouver le vrai tueur." tvg-year="1940" tvg-cast="Boris Karloff, Marjorie Reynolds, Grant Withers, William Stelling, Catherine Craig" tvg-director="William Nigh" group-title="High-Octane Action",Condamné à Mort
