#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_11_s01e02" tvg-series-id="tmdb_tv_2955_slot_11" tvg-name="Push, Nevada S01E02 - Épisode 2" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="Dark Mystery Files" tvg-description="The murder in Push sends Jim looking for clues to the killer's identity, but his efforts are hindered by the town sheriff and his dimwitted deputy, who insist the death was a suicide, although a reclusive tattoo artist may hold a clue to who commited the crime. Meanwhile, a team of well-dressed men claiming to be from the Nevada Gaming Commission arrives to deal with the consequences of the death, and Mary moves to retrieve the stolen loot." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="Épisode 2" tvg-season="1" tvg-episode="2" group-title="Push, Nevada",Push, Nevada S01E02 - Épisode 2
