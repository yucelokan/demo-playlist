#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_29_s01e01" tvg-series-id="tmdb_tv_2955_slot_29" tvg-name="Push, Nevada S01E01 - Épisode 1" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="High-Octane Action" tvg-description="When a large amount of money is stolen from a casino vault in the remote desert town of Push, Nevada, IRS agent Jim Prufrock gets a tip that the theft could be embezzlement, so he goes to investigate.  He's not made to feel welcome, however, as he is told either to get out of town or ''take careful steps,'' and a meeting with the casino manager ends with threats." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="Épisode 1" tvg-season="1" tvg-episode="1" group-title="Push, Nevada",Push, Nevada S01E01 - Épisode 1
https://download.blender.org/demo/movies/Sintel.2010.720p.mkv

#EXTINF:-1 tvg-id="tmdb_tv_2955_slot_29_s01e02" tvg-series-id="tmdb_tv_2955_slot_29" tvg-name="Push, Nevada S01E02 - Épisode 2" tvg-logo="https://image.tmdb.org/t/p/w500/xgT9e4nYQjUj4ImggCPbL0QHCfd.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/l0b3v6TPRHAPhvCi3I9axBMCDxR.jpg" tvg-type="series" tvg-genre="High-Octane Action" tvg-description="The murder in Push sends Jim looking for clues to the killer's identity, but his efforts are hindered by the town sheriff and his dimwitted deputy, who insist the death was a suicide, although a reclusive tattoo artist may hold a clue to who commited the crime. Meanwhile, a team of well-dressed men claiming to be from the Nevada Gaming Commission arrives to deal with the consequences of the death, and Mary moves to retrieve the stolen loot." tvg-year="2002" tvg-cast="Derek Cecil, Scarlett Chorvat, Armand Assante" tvg-series-title="Push, Nevada" tvg-episode-title="Épisode 2" tvg-season="1" tvg-episode="2" group-title="Push, Nevada",Push, Nevada S01E02 - Épisode 2
https://download.blender.org/demo/movies/Sintel.2010.720p.mkv

