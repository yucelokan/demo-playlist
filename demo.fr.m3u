#EXTINF:-1 tvg-id="tmdb_movie_340613" tvg-name="The Wife" tvg-logo="https://image.tmdb.org/t/p/w500/oCfoZKfgPBnC8Q7UArMkF6wJZIw.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w1280/9nCnOjdWoW9GqEyYdToeLswLNFP.jpg" tvg-type="movie" tvg-genre="High-Octane Action" tvg-description="Joan, épouse fidèle du célèbre auteur Joe Castleman, accompagne son mari à Stockholm où il doit recevoir le prix Nobel de littérature. Or dans l'avion, elle comprend petit à petit qu'après de longues années de vie commune, elle ne le supporte plus. Pourquoi ? Le passé et les rancœurs ressurgissent alors. Devra-t-elle briser leur secret au risque de tout perdre ?" tvg-year="2017" tvg-cast="Glenn Close, Jonathan Pryce, Christian Slater, Max Irons, Harry Lloyd" tvg-director="Björn Runge" group-title="High-Octane Action",The Wife
